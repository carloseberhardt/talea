          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="980" as="sourcePoint"/>
            <mxPoint x="140" y="980" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="leg-llm" value="LLM inference (HTTPS via gateway)" style="text;html=1;align=left;fontColor=#9673A6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="150" y="970" width="500" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="leg-llm-dashed-line" value="" style="endArrow=classic;edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;dashed=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="1010" as="sourcePoint"/>
            <mxPoint x="140" y="1010" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="leg-api" value="internal HTTP API (AppView's read/post API, used by Web UI and Bridge)" style="text;html=1;align=left;fontColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="150" y="1000" width="700" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="leg-note" value="&lt;b&gt;The shape.&lt;/b&gt; Every signal lives as an atproto record. Writers commit to the PDS (top); the relay broadcasts the firehose; subscribers (AppView, Bridge, Triage) react. The only out-of-band hop is the Bridge calling agents over A2A — the agents return results, and the Bridge signs them back into PDS using credentials it holds for each agent.&lt;br&gt;&lt;br&gt;&lt;b&gt;atproto-aware vs atproto-naive.&lt;/b&gt; AppView, Bridge, Triage (and the operator CLI) all speak atproto directly. Domain agents do not — they receive thread context from the Bridge via the Thread-Context A2A extension and return plain A2A responses.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pace-layering.&lt;/b&gt; Web UI is a static client app, deployable independently of the AppView. The AppView is the load-bearing tier (Bridge depends on its &lt;tt&gt;/api/thread&lt;/tt&gt; and &lt;tt&gt;/api/agents&lt;/tt&gt;), so UI churn never touches a service consumer.&lt;br&gt;&lt;br&gt;&lt;b&gt;Federation-ready.&lt;/b&gt; Both Bridge and AppView resolve every DID to its hosting PDS (did:plc via PLC, did:web via HTTPS). The diagram shows one PDS because the sandbox runs one — the code does not assume it." style="text;html=1;align=left;whiteSpace=wrap;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="660" y="850" width="490" height="180" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
