            <mxPoint x="140" y="950" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="leg-a2a" value="A2A dispatch (HTTP JSON-RPC — the only non-firehose hop)" style="text;html=1;align=left;fontColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="150" y="940" width="500" height="20" as="geometry"/>
        </mxCell>

