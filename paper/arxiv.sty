% arxiv.sty -- preprint style in the layout of the widely used
% "arXiv preprint" template (NeurIPS-derived): 6.5in x 9in text block,
% ruled title box, "A PREPRINT" running header.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arxiv}[2026/10/15 arXiv preprint style]

\RequirePackage{geometry}
\geometry{letterpaper, textwidth=6.5in, textheight=9in,
          left=1in, top=1in, headheight=12pt, headsep=25pt, footskip=30pt}

\RequirePackage{fancyhdr}
\RequirePackage{xcolor}

\newcommand{\headeright}{A Preprint}
\newcommand{\undertitle}{A Preprint}
\newcommand{\shorttitle}{\@title}

\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\thepage}%
}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\scshape\shorttitle}
\fancyhead[R]{\small\scshape\headeright}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}

% Section styling
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-2.0ex \@plus -0.5ex \@minus -0.2ex}{1.5ex \@plus 0.3ex}%
  {\large\bfseries\raggedright}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-1.8ex \@plus -0.5ex \@minus -0.2ex}{0.8ex \@plus 0.2ex}%
  {\normalsize\bfseries\raggedright}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex \@plus -0.5ex \@minus -0.2ex}{0.5ex \@plus 0.2ex}%
  {\normalsize\bfseries\raggedright}}
\renewcommand{\paragraph}{\@startsection{paragraph}{4}{\z@}%
  {1.5ex \@plus 0.5ex \@minus 0.2ex}{-1em}%
  {\normalsize\bfseries}}

\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt}

% Title block: two rules around the title, authors in a row below
% amsmath defines \And as a math symbol, so install the author
% separators at \begin{document}, after all packages have loaded.
\AtBeginDocument{%
  \def\And{\end{tabular}\hfil\linebreak[0]\hfil
    \begin{tabular}[t]{c}\ignorespaces}%
  \def\AND{\end{tabular}\hfil\linebreak[4]\hfil
    \begin{tabular}[t]{c}\ignorespaces}%
}

\renewcommand{\maketitle}{%
  \par
  \begingroup
    \renewcommand{\thefootnote}{\fnsymbol{footnote}}%
    \thispagestyle{plain}%
    \vbox{%
      \hsize\textwidth
      \linewidth\hsize
      \vskip 0.1in
      \hrule height 4pt
      \vskip 0.25in
      \centering
      {\LARGE\bfseries \@title\par}%
      \vskip 0.2in
      {\scshape\undertitle\par}%
      \vskip 0.25in
      \hrule height 1pt
      \vskip 0.09in
      \def\thanks##1{\footnote{##1}}%
      \begin{tabular}[t]{c}\@author\end{tabular}%
      \vskip 0.2in
      {\small \@date\par}%
      \vskip 0.25in
    }%
  \endgroup
  \setcounter{footnote}{0}%
}

\renewenvironment{abstract}{%
  \centerline{\large\bfseries Abstract}%
  \vspace{0.5ex}%
  \begin{quote}\small
}{%
  \par\end{quote}\vskip 1ex
}

\newcommand{\keywords}[1]{%
  \begin{quote}\small\textbf{\textit{Keywords}}\enspace #1\end{quote}%
}

\endinput
