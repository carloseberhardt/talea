# PDS Configuration for local Talea sandbox
# Copy to pds.env and update as needed

PDS_HOSTNAME=pds.talea.internal
PDS_PORT=2583
PDS_DATA_DIRECTORY=/pds
PDS_DID_PLC_URL=http://plc:2582
PDS_JWT_SECRET=change-me-jwt-secret-at-least-32-chars!!
PDS_ADMIN_PASSWORD=change-me-admin-password
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
PDS_SERVICE_HANDLE_DOMAINS=.test
PDS_INVITE_REQUIRED=false
PDS_BSKY_APP_VIEW_URL=
PDS_BSKY_APP_VIEW_DID=
PDS_REPORT_SERVICE_URL=
PDS_REPORT_SERVICE_DID=
PDS_MOD_SERVICE_URL=
PDS_MOD_SERVICE_DID=
PDS_CRAWLERS=
PDS_BLOBSTORE_DISK_LOCATION=/pds/blobs
PDS_DEV_MODE=true
